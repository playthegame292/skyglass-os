[Unit]
Description=Skyglass RGB LED (flashlight, status light, party effects)
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/skyglass-ledd
Restart=always
RestartSec=2
RuntimeDirectory=skyglass-led
RuntimeDirectoryMode=0750
StateDirectory=skyglass
Nice=-5

[Install]
WantedBy=multi-user.target
