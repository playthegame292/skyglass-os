{
  "manifest_version": 3,
  "name": "Skyglass Browser Bar",
  "version": "1.0",
  "description": "Back / Home / Close buttons and the Sky Search Aero look for the Skyglass phone browser.",
  "background": { "service_worker": "bg.js" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bar.js"], "run_at": "document_idle", "all_frames": false },
    { "matches": ["https://duckduckgo.com/*", "https://*.duckduckgo.com/*"], "css": ["sky.css"], "run_at": "document_start" }
  ]
}
