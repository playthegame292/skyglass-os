#!/bin/bash
# Skyglass OS session: runs the phone UI under a Wayland compositor, forever.
#  - labwc when it's installed: it has layer-shell, input-method and text-input, so the
#    squeekboard on-screen keyboard works in Linux apps. cage is the fallback.
#  - crashes are restarted automatically
#  - after 2 quick crashes in a row it switches to cage; after 3, SAFE MODE (no GPU, fresh browser profile)
#  - after 5 it stops and shows the error on screen with a terminal, instead of a blank display
# COMPOSITOR=cage (or labwc) in /etc/skyglass/display.conf forces one.
# Create ~/.skyglass-console to get a plain tty instead of the UI.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Skyglass
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland SDL_VIDEODRIVER=wayland
LOG="$HOME/.cache/skyglass"; mkdir -p "$LOG"
# Touchscreen phone: no mouse pointer (an invisible cursor theme). SHOW_CURSOR=1 in
# /etc/skyglass/display.conf brings it back, e.g. when you plug in a real mouse.
SHOW_CURSOR=$(sed -n 's/^SHOW_CURSOR=//p' /etc/skyglass/display.conf 2>/dev/null)
if [ "$SHOW_CURSOR" != 1 ] && [ -d /usr/share/icons/skyglass-none ]; then
  # cage always loads the theme called "default": XCURSOR_PATH makes that one invisible too
  export XCURSOR_THEME=skyglass-none XCURSOR_SIZE=24 XCURSOR_PATH=/usr/share/skyglass/cursors
  mkdir -p "$HOME/.config/gtk-3.0"
  grep -qs gtk-cursor-theme-name "$HOME/.config/gtk-3.0/settings.ini" ||
    printf '[Settings]\ngtk-cursor-theme-name=skyglass-none\n' >>"$HOME/.config/gtk-3.0/settings.ini"
fi
COMPOSITOR=$(sed -n 's/^COMPOSITOR=//p' /etc/skyglass/display.conf 2>/dev/null)
# keyboard layout for USB/Bluetooth keyboards (Settings › Keyboard), read by both compositors
LAYOUT=$(sed -n 's/^KEYBOARD_LAYOUT=//p' /etc/skyglass/display.conf 2>/dev/null)
[ -n "$LAYOUT" ] && export XKB_DEFAULT_LAYOUT=$LAYOUT
fails=0
clear
echo "Skyglass OS is starting…"
while [ ! -e "$HOME/.skyglass-console" ]; do
  start=$(date +%s)
  if [ "$fails" -ge 3 ]; then export SKYGLASS_SAFE=1; else unset SKYGLASS_SAFE; fi
  comp=cage
  if command -v labwc >/dev/null; then
    case "$COMPOSITOR" in
      cage) ;;
      labwc) comp=labwc ;;
      *) [ "$fails" -lt 2 ] && comp=labwc ;;   # labwc keeps crashing: fall back to cage
    esac
  fi
  export SKYGLASS_COMPOSITOR=$comp
  echo "$comp" >"$LOG/compositor"
  if [ "$comp" = labwc ]; then
    # -S: labwc quits when the shell does, just like cage
    labwc -C /etc/skyglass/labwc -S /usr/local/bin/skyglass-session-inner >"$LOG/labwc.log" 2>&1
  else
    cage -d -s -- /usr/local/bin/skyglass-session-inner >"$LOG/cage.log" 2>&1
  fi
  code=$?
  # a run shorter than 20 s counts as a crash; a long healthy run resets the counter
  if [ $(( $(date +%s) - start )) -lt 20 ]; then fails=$((fails + 1)); else fails=0; fi
  if [ "$fails" -ge 5 ]; then
    skyglass-led error ui >/dev/null 2>&1   # red fast blink: the UI could not start (cleared when it does)
    clear
    echo "=============================================================="
    echo " Skyglass shell failed to start (exit code $code). Last log lines:"
    echo "=============================================================="
    echo "--- $LOG/$comp.log"; tail -n 15 "$LOG/$comp.log"
    echo "--- $LOG/shell.log"; tail -n 8 "$LOG/shell.log" 2>/dev/null
    echo
    echo "Checks:  skyglass-doctor   ·   skyglass-display info"
    echo "Retry:   skyglass-session  ·   Reboot: sudo reboot"
    echo
    export SKYGLASS_FAILED=1; exec bash -l   # profile sees this and will not relaunch the UI
  fi
  echo "Skyglass shell stopped ($comp, exit $code), restarting… ($fails)"
  sleep 1
done
